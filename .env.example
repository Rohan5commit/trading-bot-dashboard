# IMAP Configuration (uses same credentials as SMTP)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USE_TLS=true

# SMTP credentials (used for IMAP login)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email subject filters (comma-separated, exact matches)
# The date portion YYYY-MM-DD is appended by the sender
SUBJECT_FILTERS="Trading Bot Daily Report (Core) - ,Trading Bot Daily Report (AI) - "

# Lookback window in days (how far back to search)
LOOKBACK_DAYS=30

# Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname
